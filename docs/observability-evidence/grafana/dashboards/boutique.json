{
 "uid": "boutique-observability",
 "title": "Boutique API: Unified Observability",
 "tags": [
  "boutique",
  "opentelemetry"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview (RED metrics: Rate, Errors, Duration)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requests / sec",
   "description": "Total HTTP requests handled per second (source: OpenTelemetry FastAPI auto-instrumentation).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"boutique-api\"}[$__rate_interval]))",
     "legendFormat": "req/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Server error rate (5xx)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (sum(rate(http_server_duration_milliseconds_count{service_name=\"boutique-api\",http_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_duration_milliseconds_count{service_name=\"boutique-api\"}[$__rate_interval]))",
     "legendFormat": "5xx %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 4,
